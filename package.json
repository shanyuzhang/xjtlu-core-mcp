{
  "name": "canvas-session-mcp",
  "version": "0.1.0",
  "description": "MCP server that connects AI assistants (Claude, Cursor, Codex…) to Canvas LMS using your normal browser login — no access token needed. Read-only.",
  "main": "src/server.js",
  "scripts": {
    "test": "node --test",
    "xjtlu": "node bin/xjtlu-cli.js",
    "web": "node bin/xjtlu-cli.js web",
    "package:xjtlu": "node scripts/build-xjtlu-bundle.mjs"
  },
  "keywords": [
    "canvas",
    "canvas-lms",
    "instructure",
    "mcp",
    "model-context-protocol",
    "claude",
    "student",
    "ai"
  ],
  "author": "CorCvusRamboChen",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "htmlparser2": "^10.1.0",
    "domutils": "^3.2.2",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "html-to-text": "^10.0.1",
    "mammoth": "^1.13.0",
    "playwright-core": "^1.63.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "bin": {
    "canvas-session-mcp": "bin/cli.js",
    "xjtlu-session-mcp": "bin/xjtlu-cli.js"
  },
  "files": [
    "bin",
    "src",
    "web",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CorCvusRamboChen/canvas-session-mcp.git"
  },
  "homepage": "https://corcvusrambochen.github.io/canvas-session-mcp/"
}
